# The canary files are hashed byte for byte (lab/seed-manifest.json). Never let
# git convert their line endings (core.autocrlf) or diff them as text.
lab/canary/** binary
# Written with LF by `python -m seeder seed`; keep it LF on every checkout.
lab/seed-manifest.json text eol=lf
shared/testdata/office-content-v1/*.docx binary
shared/testdata/office-content-v1/*.xlsx binary
# The result schema is embedded into the Worker as bytes and read by the Cloud
# by path, and the shared vectors are read by both builds (W4.1): keep them LF
# on every checkout.
shared/schemas/*.json text eol=lf
shared/testdata/**/*.json text eol=lf
# The pinned TSA root is embedded into the Worker as bytes and handed to
# `openssl ts -verify` by an auditor (W4.4): keep it LF on every checkout.
shared/tsa/*.pem text eol=lf
docs/api/openapi-v1.json text eol=lf
cloud/tests/registration-keys.json text eol=lf
