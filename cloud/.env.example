# The Cloud's settings (app/settings.py). The app reads the process environment
# only; it never reads this file or a .env itself.
#
# The local stack needs no .env: docker-compose.yml carries its own local-only
# values. This file lists what a deployment sets (C5.12). Copy it to .env
# (gitignored) on the host and fill it in there. No value below works anywhere.

# Required. The app stops at startup, naming the variable, when one is missing.
# The scheduler (python -m app.scheduler) and the CLI (manage.py) read
# DATABASE_URL and LOG_LEVEL alone, as a migration does.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
S3_ENDPOINT=https://<s3-host>
S3_ACCESS_KEY=<access key>
S3_SECRET_KEY=<secret key>
S3_BUCKET=<bucket>
# At least 32 characters, random.
SECRET_KEY=<random>

# Optional, with their defaults.
#S3_REGION=us-east-1
# C6.2: the S3 endpoint a user's browser can open, for the pre-signed download
# links (SigV4 signs the host, so a URL signed for an internal name doesn't
# open elsewhere). Unset, the links are signed for S3_ENDPOINT; C5.12 decides
# the host.
#S3_PUBLIC_ENDPOINT=https://<s3-host-the-browser-reaches>
# C6.1: the session cookie's Secure flag. true behind TLS; false only for a
# stack on plain http, such as the local one.
#SESSION_COOKIE_SECURE=true
# debug, info, warning or error, in any case; the migration's lines follow it too.
#LOG_LEVEL=info

# Optional mail settings (C7.1).
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=

# Tests only (docs/testing.md, "Cloud"); the database's name must end in _test.
#TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@127.0.0.1:55432/<name>_test
