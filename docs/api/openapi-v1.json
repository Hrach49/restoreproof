{
  "components": {
    "schemas": {
      "Accepted": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "pass",
              "fail",
              "error"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "state"
        ],
        "title": "Accepted",
        "type": "object"
      },
      "ConnectorRef": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "ConnectorRef",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Job": {
        "additionalProperties": false,
        "properties": {
          "client": {
            "additionalProperties": true,
            "title": "Client",
            "type": "object"
          },
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "connector": {
            "$ref": "#/components/schemas/ConnectorRef"
          },
          "restore_point": {
            "title": "Restore Point",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "sample_mail": {
            "title": "Sample Mail",
            "type": "integer"
          },
          "sample_od": {
            "title": "Sample Od",
            "type": "integer"
          },
          "sample_sp": {
            "title": "Sample Sp",
            "type": "integer"
          },
          "screenshots_enabled": {
            "title": "Screenshots Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "run_id",
          "client_id",
          "client",
          "connector",
          "sample_mail",
          "sample_sp",
          "sample_od",
          "restore_point",
          "screenshots_enabled"
        ],
        "title": "Job",
        "type": "object"
      },
      "JobsDocument": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "const": "restoreproof.jobs.v1",
            "default": "restoreproof.jobs.v1",
            "title": "Format",
            "type": "string"
          },
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "maxItems": 5,
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "JobsDocument",
        "type": "object"
      },
      "RegisterBody": {
        "additionalProperties": false,
        "properties": {
          "install_token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Install Token",
            "type": "string"
          },
          "public_key_pem": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Public Key Pem",
            "type": "string"
          },
          "version": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[ -~]+$",
            "title": "Version",
            "type": "string"
          },
          "worker_name": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Worker Name",
            "type": "string"
          }
        },
        "required": [
          "install_token",
          "public_key_pem",
          "worker_name",
          "version"
        ],
        "title": "RegisterBody",
        "type": "object"
      },
      "Registered": {
        "additionalProperties": false,
        "properties": {
          "api_token": {
            "title": "Api Token",
            "type": "string"
          },
          "key_id": {
            "title": "Key Id",
            "type": "string"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "api_token",
          "key_id"
        ],
        "title": "Registered",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "RestoreProof Cloud",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/jobs": {
      "get": {
        "operationId": "jobs_v1_jobs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsDocument"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not authenticated: no valid token, whatever the reason.",
            "headers": {
              "WWW-Authenticate": {
                "description": "`Bearer`",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Jobs"
      }
    },
    "/v1/results": {
      "post": {
        "operationId": "upload_v1_results_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "items.csv": {
                    "description": "an attachment the result lists, under its name",
                    "format": "binary",
                    "type": "string"
                  },
                  "result": {
                    "description": "result.json, the result's canonical bytes",
                    "format": "binary",
                    "type": "string"
                  },
                  "screenshot.png": {
                    "description": "an attachment the result lists, under its name",
                    "format": "binary",
                    "type": "string"
                  },
                  "signature": {
                    "description": "signature.json",
                    "format": "binary",
                    "type": "string"
                  },
                  "timestamp": {
                    "description": "timestamp.tst, when the run was timestamped",
                    "format": "binary",
                    "type": "string"
                  },
                  "veeam-session.log": {
                    "description": "an attachment the result lists, under its name",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "result",
                  "signature"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The bundle doesn't verify (the verifier's word), or the body is malformed, has a part twice or a part the result doesn't list."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not authenticated: no valid token, whatever the reason.",
            "headers": {
              "WWW-Authenticate": {
                "description": "`Bearer`",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such run of this Worker (`run_id: no such run`)."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The run was never handed out (`run_id: not dispatched`), the bundle's client isn't the run's (`client_mismatch`), or the run holds another bundle (`bundle_conflict`)."
          },
          "411": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No Content-Length."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The body, or a listed attachment, is over the cap."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not multipart/form-data."
          }
        },
        "summary": "Upload"
      }
    },
    "/v1/workers/register": {
      "post": {
        "operationId": "register_v1_workers_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registered"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The key is not an accepted Ed25519 public key (the file's form, a non-canonical encoding, no point of the curve, or a small-order point)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not authenticated: no valid token, whatever the reason.",
            "headers": {
              "WWW-Authenticate": {
                "description": "`Bearer`",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The key is already registered."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register"
      }
    }
  }
}
