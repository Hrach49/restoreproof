{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restoreproof.local/schemas/client-profile.v1.json",
  "title": "RestoreProof client profile v1",
  "description": "restoreproof.client-profile.v1: one client of a Worker, as a job carries it and as a profile file holds it (W4.10, docs/decisions.md 2026-10-09). A client is one Microsoft 365 tenant, which the backup product backs up as one organisation. IDs only: the organisation's name as the backup product knows it, the tenant, the Worker app's application (client) ID, the restoretest mailbox and the four Graph IDs of the restore targets, under the names config.json uses for the same values, each with config.json's shape rule. No name, URL or secret. Every key is required and no other is allowed. The schema uses only keywords JSON Schema draft 7 and 2020-12 read alike; veeam_org_name is tenant text and gets a length alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "veeam_org_name",
    "graph_tenant_id",
    "graph_client_id",
    "test_mailbox",
    "test_site_id",
    "test_library_id",
    "test_onedrive_drive_id",
    "test_onedrive_folder_id"
  ],
  "properties": {
    "format": {
      "const": "restoreproof.client-profile.v1"
    },
    "veeam_org_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "graph_tenant_id": {
      "$ref": "#/$defs/guid"
    },
    "graph_client_id": {
      "$ref": "#/$defs/guid"
    },
    "test_mailbox": {
      "type": "string",
      "minLength": 15,
      "maxLength": 1024,
      "pattern": "^[Rr][Ee][Ss][Tt][Oo][Rr][Ee][Tt][Ee][Ss][Tt]@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$",
      "not": {
        "pattern": "\n"
      }
    },
    "test_site_id": {
      "type": "string",
      "minLength": 90,
      "maxLength": 152,
      "pattern": "^[A-Za-z0-9-]{1,63}\\.[Ss][Hh][Aa][Rr][Ee][Pp][Oo][Ii][Nn][Tt]\\.[Cc][Oo][Mm],[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12},[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
      "not": {
        "pattern": "\n"
      }
    },
    "test_library_id": {
      "$ref": "#/$defs/drive_id"
    },
    "test_onedrive_drive_id": {
      "$ref": "#/$defs/drive_id"
    },
    "test_onedrive_folder_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9!_-]{1,200}$",
      "not": {
        "pattern": "\n"
      }
    }
  },
  "$defs": {
    "guid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "drive_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 202,
      "pattern": "^b![A-Za-z0-9_-]{1,200}$",
      "not": {
        "pattern": "\n"
      }
    }
  }
}
